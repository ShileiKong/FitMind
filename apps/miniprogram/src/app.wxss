page { background:var(--fm-base,#000); color:var(--fm-text,#F5F7F6); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif; font-size:15px;font-weight:400; }
view,text,input,textarea,button,picker { box-sizing:border-box; }
.page { min-height:100vh; padding:24px 24px 32px; display:flex; flex-direction:column; gap:22px; color:var(--fm-text,#F5F7F6);background:radial-gradient(ellipse 85% 55% at 90% 0%,var(--fm-glow,#00D97629) 0%,var(--fm-glow-fade,#0066380a) 50%,transparent 100%),var(--fm-base,#000);background-size:100% calc(100vh - 180px - env(safe-area-inset-bottom));background-repeat:no-repeat; }
.tab-page { padding-bottom:calc(180px + env(safe-area-inset-bottom)); }
.heading { display:flex; align-items:center; }
.brand { display:flex; align-items:center; gap:7px; margin-bottom:14px; }
.brand-dot { width:6px;height:6px;border-radius:3px;background:var(--fm-accent,#00ED85); }
.brand-name { font-size:13px;font-weight:600;letter-spacing:.4px; }
.brand-tagline { font-size:11px;color:var(--fm-muted,#93A69B); }
.title { font-size:32px;font-weight:700;letter-spacing:-1.1px;line-height:44px; }
.subtitle { margin-top:6px;color:var(--fm-muted,#93A69B);font-size:12px;line-height:19px; }
.card { display:flex;flex-direction:column;gap:14px;padding:22px;border:1px solid var(--fm-accent-14,#00ED8514);border-radius:26px;background:linear-gradient(135deg,#ffffff04,transparent),var(--fm-surface,#080E0B);overflow:hidden; }
.row { display:flex;align-items:center;gap:10px; } .between { justify-content:space-between; } .wrap { flex-wrap:wrap; } .grow { flex:1;min-width:0; }
.section { font-size:18px;font-weight:600;letter-spacing:-.4px;line-height:26px; } .text { font-size:15px;line-height:24px;font-weight:400; } .muted { color:var(--fm-muted,#93A69B);font-size:12px;line-height:19px;font-weight:400; } .small { font-size:12px; } .green { color:var(--fm-accent,#00ED85); }
.eyebrow { color:var(--fm-accent,#00ED85);font-size:10px;letter-spacing:1.1px;font-weight:600;line-height:16px; } .big { font-size:42px;font-weight:500;letter-spacing:-1.5px;font-variant-numeric:tabular-nums; }
.icon { width:18px;height:18px;flex-shrink:0; } .chevron { width:13px;height:13px; } .line { height:1px; background:var(--fm-line,#173426); }
button { width:100% !important;display:flex;align-items:center;justify-content:center;min-height:50px;border-radius:16px;padding:12px 16px;background:var(--fm-accent,#00ED85);color:var(--fm-on-accent,#001A0D);font-size:14px;font-weight:600;line-height:22px;border:0;margin:0; }
button::after { border:0; } button[disabled] { opacity:.5; } .secondary { background:var(--fm-accent-05,#00ED8505);border:1px solid var(--fm-accent-24,#00ED8524);color:var(--fm-text,#F5F7F6); }
.text-button { width:auto !important;min-height:28px;background:transparent;font-size:12px;color:var(--fm-muted,#93A69B);font-weight:400;padding:0;justify-content:flex-start; } .text-button.green { color:var(--fm-accent,#00ED85); }
.danger-button,.over { color:var(--fm-danger,#FFA39B); } .buttons { display:flex;gap:10px; } .buttons button { flex:1; }
.spaced { margin-top:14px; } .gap { height:0; } .chip,.badge { padding:6px 10px;background:var(--fm-soft,#072B19);border-radius:10px; }
.chip { font-size:15px;line-height:24px; } .badge { color:var(--fm-accent,#00ED85);font-size:10px; }
.selected { border:1px solid var(--fm-accent,#00ED85); } .selectable { padding:13px;border:1px solid var(--fm-accent-20,#00ED8520);border-radius:16px; }
input,textarea,.input { width:100%;min-height:52px;padding:13px 14px;background:var(--fm-input,#0C1711);border:1px solid var(--fm-accent-20,#00ED8520);border-radius:16px;color:var(--fm-text,#F5F7F6);font-size:15px;line-height:24px; }
textarea { min-height:96px; } .field { display:flex;flex-direction:column;gap:6px; } .label { color:var(--fm-muted,#93A69B);font-size:12px;line-height:19px; }
.form-grid { display:grid;grid-template-columns:1fr 1fr;gap:12px; } picker { padding:13px 14px;background:var(--fm-input,#0C1711);border:1px solid var(--fm-accent-20,#00ED8520);border-radius:16px; }
.error { color:var(--fm-danger,#FFA39B);font-size:13px;line-height:20px;white-space:pre-wrap; } .empty { color:var(--fm-muted,#93A69B);font-size:12px;line-height:19px; }
.pending { padding:14px;border:1px solid var(--fm-pending,#554B1B);border-radius:16px;color:var(--fm-warning,#E8D6A0);font-size:12px; }
.record-card { padding:14px; } .record { padding:12px 0;border-bottom:1px solid var(--fm-line,#173426); } .record-title { font-size:15px;line-height:24px; }
.settings-button { width:48px !important;height:48px;min-height:48px;flex-shrink:0;padding:13px;border-radius:24px;background:var(--fm-button-surface,#07130C);border:1px solid var(--fm-accent-24,#00ED8524); } .settings-button image { width:19px;height:19px; }
.target-button { min-height:44px;gap:3px; }
.budget-row { display:flex;gap:10px; } .budget-large { flex:1;min-width:0;padding:16px;gap:6px;border-color:var(--fm-accent-2e,#00ED852E);background:linear-gradient(135deg,var(--fm-budget-glow,#00D66C1f),transparent),var(--fm-budget-surface,#04120B); }
.budget-label { font-size:14px;font-weight:500; } .budget-icon { width:28px;height:28px;background:var(--fm-accent-14,#00ED8514);border-radius:14px;display:flex;align-items:center;justify-content:center; } .budget-icon image { width:15px;height:15px; }
.ring { width:104px;max-width:100%;height:104px;margin:3px auto;position:relative; } budget-ring { position:absolute;inset:0; }
.ring-value { position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:2px; }
.ring-amount,.macro-amount { color:var(--fm-accent,#00ED85);font-weight:500;font-variant-numeric:tabular-nums;letter-spacing:-1.2px;line-height:34px; }
.budget-unit { font-size:10px;line-height:16px;color:var(--fm-muted,#93A69B);letter-spacing:0; } .budget-status { color:var(--fm-muted,#93A69B);font-size:10px;line-height:16px;text-align:center; } .budget-status.over { color:var(--fm-danger,#FFA39B); }
.budget-recorded { font-size:10px;line-height:15px;color:var(--fm-muted,#93A69B); } .budget-large .budget-recorded { text-align:center; }
.macros { gap:8px; } .budget-small { flex:1;min-width:0;padding:12px;gap:5px;border-radius:22px; } .macro-value { display:flex;align-items:baseline;gap:4px;margin:2px 0; } .approx { font-size:10px; }
.macro-track { height:3px;background:var(--fm-accent-12,#00ED8512);border-radius:2px;overflow:hidden; } .macro-track view { height:3px;background:var(--fm-accent,#00ED85); }
.quick-records { display:flex;gap:10px; } .quick-records button { flex:1;min-width:0;min-height:46px;padding:0 6px;border-radius:18px;font-weight:400;font-size:13px;gap:6px; } .quick-records image { width:16px;height:16px; } .quick-records .plus { width:11px;height:11px; }
.chat-page { gap:16px;padding-bottom:calc(150px + env(safe-area-inset-bottom)); }
.chat-user { max-width:92%;align-self:flex-end;display:flex;flex-direction:column;gap:14px;padding:22px;background:var(--fm-input,#0C1711);border:1px solid var(--fm-accent-14,#00ED8514);border-radius:26px;white-space:pre-wrap;font-size:15px;line-height:24px; }
.chat-message { display:flex;flex-direction:column;gap:8px; } .chat-reply { display:flex;flex-direction:column;gap:8px; } .chat-answer { font-size:15px;line-height:24px;white-space:pre-wrap; } .receipt { color:var(--fm-accent,#00ED85);font-size:12px;line-height:19px; }
.chat-composer { position:fixed;bottom:0;left:0;right:0;padding:12px 20px calc(8px + env(safe-area-inset-bottom));background:var(--fm-base,#000);z-index:5; }
.photo-preview { width:75px;height:75px;border-radius:12px; } .exercise { padding:12px 0;border-bottom:1px solid var(--fm-line,#173426); } .exercise:last-child { border-bottom:0; }
.skin-deepseek .card{box-shadow:0 5px 20px #344E9010}.whale-welcome{position:relative;min-height:212px;border-radius:28px;overflow:hidden;padding:25px 21px;background:linear-gradient(115deg,#E5EDFF,#E6E2FC);border:1px solid #CCD7F9}.whale-welcome-copy{position:relative;z-index:1;width:60%;display:flex;flex-direction:column;gap:12px}.whale-welcome-title{font-size:24px;font-weight:700;line-height:33px;letter-spacing:-.6px;color:#25345A}.whale-welcome .eyebrow{font-size:9px;letter-spacing:1px}.whale-welcome .muted{font-size:11px;line-height:19px;color:#52658D}.whale-welcome-character{position:absolute;width:144px;height:209px;right:1px;bottom:-9px;z-index:1}.whale-orbit{position:absolute;width:192px;height:192px;right:-27px;bottom:-45px;border:1px solid #FFFFFF99;border-radius:50%;box-shadow:0 0 0 20px #FFFFFF1F,0 0 0 40px #FFFFFF15}.coach-avatar{width:28px;height:28px;border-radius:50%;background:#E2E8FC;overflow:hidden;flex-shrink:0}.coach-avatar image{width:34px;height:45px;margin-left:-3px}.coach-message-header{display:flex;align-items:center;gap:9px}
.whale-welcome-title,.whale-welcome .muted{white-space:pre-line}.whale-welcome-character{bottom:0}
.budget-note{font-size:9px;line-height:14px;color:var(--fm-muted,#93A69B)}.budget-large .budget-note{text-align:center}
.budget-source{display:flex;align-items:center;justify-content:space-between;font-size:10px;line-height:18px;margin-top:3px;color:var(--fm-accent,#00ED85)}.budget-source image{width:11px;height:11px}.budget-large .budget-source{justify-content:center;gap:4px}
