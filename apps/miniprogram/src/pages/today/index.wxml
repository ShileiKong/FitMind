<view class="page tab-page skin-{{skin}}" style="{{skinStyle}}">
  <view class="heading between">
    <view class="grow">
      <view class="brand"><view class="brand-dot"/><text class="brand-name">FitMind</text><text class="brand-tagline">你的私人教练</text></view>
      <view class="title">今日</view><view class="subtitle">{{date ? date + ' · ' + timezone : '读取本地数据…'}}</view>
    </view>
    <button class="settings-button" bindtap="openSettings" aria-label="本地数据与 AI 设置"><image src="/assets/icons/settings-2-{{skinTextIcon}}.png"/></button>
  </view>
  <view class="whale-welcome" wx:if="{{skin === 'deepseek'}}"><view class="whale-welcome-copy"><text class="eyebrow">DEEPSEEK · 大肥鱼陪伴</text><text class="whale-welcome-title">今天，也要
好好照顾自己</text><text class="muted">每一口水，每一组训练
我都陪你记下来。</text></view><view class="whale-orbit"/><image class="whale-welcome-character" src="/assets/skins/deepseek-mascot.png" mode="aspectFit"/></view>
  <view class="card" wx:if="{{reminder}}"><view class="eyebrow">明日训练提醒</view><view class="section">{{reminder.name}}</view><view class="muted">{{reminder.local_date}} · {{reminder.exercises.length}} 个动作</view><button class="secondary" bindtap="tomorrowTraining">查看明日详细计划</button></view>
  <view class="error" wx:if="{{error && connected}}">{{error}}</view>
  <view class="card" wx:if="{{showSetup}}"><view class="eyebrow">{{setupStarted ? '继续认识你' : '先认识一下你'}}</view><view class="section">让教练了解你的目标</view><view class="muted">聊聊身体参数、训练偏好和运动时间。答案会逐步保存。</view><button class="secondary" bindtap="setup">{{setupStarted ? '继续首次引导' : '和教练一起设置'}}</button></view>
  <view class="between row"><view><view class="section">饮食目标</view><view class="muted" style="font-size:11px;margin-top:3px">{{dietApplied ? '已应用 · 今日剩余额度' : '每日营养与饮水额度'}}</view></view><button class="text-button green target-button" data-mode="target" bindtap="edit">调整目标<image class="chevron" src="/assets/icons/chevron-right-{{skinAccentIcon}}.png"/></button></view>
  <view class="budget-row">
    <view wx:for="{{budgets}}" wx:key="key" wx:if="{{index < 2}}" class="card budget-large" data-key="{{item.key}}" bindtap="nutritionDetails" aria-role="button" aria-label="查看{{item.name}}摄入来源">
      <view class="between row"><text class="budget-label">{{item.name}}</text><view class="budget-icon"><image src="/assets/icons/{{index === 0 ? 'droplets' : 'flame'}}-{{skinAccentIcon}}.png"/></view></view>
      <view class="ring"><budget-ring percent="{{item.percent}}"/><view class="ring-value"><text class="ring-amount" style="font-size:{{item.remaining.length > 4 ? 24 : 30}}px">{{item.remaining}}</text><text class="budget-unit">{{item.estimated && item.remaining !== '—' ? '约 · ' : ''}}{{item.unit}} 剩余</text></view></view>
      <text class="budget-status {{item.over ? 'over' : ''}}">{{item.status}}</text><text class="budget-recorded">已记录 {{item.total === '—' ? '0' : item.total}} {{item.unit}}{{item.target !== '—' ? ' / ' + item.target : ''}}</text><text class="budget-note" wx:if="{{item.incomplete}}">{{item.note}}</text><view class="budget-source"><text>查看来源</text><image src="/assets/icons/chevron-right-{{skinAccentIcon}}.png"/></view>
    </view>
  </view>
  <view class="budget-row macros">
    <view wx:for="{{budgets}}" wx:key="key" wx:if="{{index > 1}}" class="card budget-small" data-key="{{item.key}}" bindtap="nutritionDetails" aria-role="button" aria-label="查看{{item.name}}摄入来源"><text class="muted">{{item.name}}</text><view class="macro-value"><text class="macro-amount" style="font-size:{{item.remaining.length > 3 ? 22 : 27}}px"><text class="approx" wx:if="{{item.estimated && item.remaining !== '—'}}">约 </text>{{item.remaining}}</text><text class="budget-unit">g</text></view><view class="macro-track"><view style="width:{{item.percent}}%"/></view><text class="budget-status {{item.over ? 'over' : ''}}">{{item.status}}</text><text class="budget-recorded">已记 {{item.total === '—' ? '0' : item.total}} g</text><text class="budget-note" wx:if="{{item.incomplete}}">{{item.note}}</text><view class="budget-source"><text>查看来源</text><image src="/assets/icons/chevron-right-{{skinAccentIcon}}.png"/></view></view>
  </view>
  <view class="quick-records">
    <button class="secondary" data-mode="water" bindtap="edit"><image src="/assets/icons/droplets-{{skinAccentIcon}}.png"/><text>饮水</text><image class="plus" src="/assets/icons/plus-{{skinMutedIcon}}.png"/></button>
    <button class="secondary" data-mode="food" bindtap="edit"><image src="/assets/icons/utensils-{{skinAccentIcon}}.png"/><text>饮食</text><image class="plus" src="/assets/icons/plus-{{skinMutedIcon}}.png"/></button>
    <button class="secondary" data-mode="body" bindtap="edit"><image src="/assets/icons/activity-{{skinAccentIcon}}.png"/><text>身体</text><image class="plus" src="/assets/icons/plus-{{skinMutedIcon}}.png"/></button>
  </view>
  <view class="card"><view class="row between"><view class="row"><image class="icon" src="/assets/icons/dumbbell-{{skinAccentIcon}}.png"/><text class="section">运动目标{{trainingGoal ? ' · 已应用' : ''}}</text></view><image class="icon" src="/assets/icons/arrow-up-right-{{skinMutedIcon}}.png"/></view><text class="text" style="font-size:19px">{{day ? day.name : trainingGoal ? '今日休息 · 计划已启用' : '今天还没有训练安排'}}</text><text class="muted">{{day ? trainingText : trainingGoal ? trainingGoal.name : '在计划页制定计划，或让 AI 教练一起安排。'}}</text><text class="muted" wx:if="{{!day && nextTraining}}">下次训练 · {{nextTraining.local_date}} · {{nextTraining.name}}</text><button class="secondary" bindtap="training">{{day || trainingGoal ? '查看训练计划' : '制定训练计划'}}</button></view>
  <view class="row between"><text class="section">今日记录</text><text class="muted">{{records.length}} 条</text></view>
  <text class="muted" wx:if="{{!records.length}}">尚无记录。通过上方按钮或底部对话输入。</text>
  <view class="card record-card" wx:for="{{records}}" wx:key="id" data-id="{{item.id}}" bindtap="editRecord"><view class="row between"><text class="text">{{item.title}}</text><text class="muted green">更正 ↗</text></view><text class="muted" wx:if="{{item.kind === 'food'}}">{{item.subtitle}}</text></view>
  <pending-inputs items="{{pending}}" busy="{{busy}}" bind:retry="retryInput" bind:discard="discardInput"/>
</view>
