.photo-review{padding-bottom:calc(32px + env(safe-area-inset-bottom));}.review-photo{width:100%;max-height:300px;border-radius:24px;background:var(--fm-input,#0C1711);}.review-actions{display:flex;flex-direction:column;gap:10px;padding-bottom:env(safe-area-inset-bottom);}.portion-warning{display:flex;flex-direction:column;gap:10px;color:var(--fm-warning,#E8D6A0);font-size:12px;line-height:21px;}.portion-warning label{display:flex;align-items:flex-start;gap:5px;}.record-id{word-break:break-all;}.photo-review textarea{min-height:88px;}.photo-review .card{overflow:visible;}
