.skin-option{border:2px solid transparent;border-radius:28px;overflow:hidden;background:var(--fm-surface,#080E0B);box-shadow:0 5px 24px #25345A08}.skin-option.chosen{border-color:var(--fm-accent,#00ED85)}.skin-preview{height:210px;position:relative;overflow:hidden;padding:25px;display:flex;align-items:center;justify-content:space-between}.whale-preview{background:radial-gradient(ellipse at 85% 100%,#B7C8F488,transparent 60%),linear-gradient(120deg,#EBF4FF,#E8E5FF);color:#25345A}.whale-copy{z-index:1;width:57%}.preview-caption{display:block;font-size:10px;font-weight:700;letter-spacing:2px;opacity:.7}.preview-title{display:block;font-size:27px;line-height:38px;font-weight:700;letter-spacing:-.7px;margin:12px 0}.skin-character{position:absolute;right:4px;bottom:-13px;width:158px;height:216px}.skin-swatches{display:flex;gap:7px;margin-top:17px}.skin-swatches view{width:15px;height:15px;border-radius:50%;border:1px solid #25345A12}.midnight-preview{background:radial-gradient(ellipse at 100% 0,#00ED852A,transparent 70%),#020805;color:#F5F7F6}.sample-ring{width:102px;height:102px;display:flex;align-items:center;justify-content:center;flex-direction:column;border:5px solid #00ED85;border-left-color:#173426;border-radius:50%;color:#00ED85;font-size:35px}.sample-unit{font-size:5px;letter-spacing:.8px;margin-top:3px}.skin-description{padding:20px;display:flex;flex-direction:column;gap:10px}.skin-applied{color:var(--fm-accent,#00ED85);font-size:11px;font-weight:600}.choose-skin{margin-top:5px}.skin-description .section{font-size:17px}.skin-description .row{gap:6px}
.preview-title{white-space:pre-line}.skin-character{bottom:0;height:203px}
