# Backend only: copy this file to apps/api/.env. Restart API after changes.
PORT=8787
HOST=127.0.0.1
# iPhone on same Wi-Fi: HOST=0.0.0.0
# Resolved relative to apps/api when using npm scripts.
DATA_DIR=../../data
# Empty = generate a personal token in data/access-token on first start.
# This is the APP password, not the model vendor key.
APP_ACCESS_TOKEN=

# unconfigured | responses | chat_completions | demo
AI_PROVIDER=unconfigured
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# Optional; empty keeps the provider default. DeepSeek: none | low | high | max.
AI_REASONING_EFFORT=

# Image understanding can use a different provider; key/base fall back to AI_*.
VISION_PROVIDER=responses
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=

# File transcription; configure independently.
TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=

AGENT_MODEL_TIMEOUT_MS=60000
AGENT_MESSAGE_TIMEOUT_MS=180000
AGENT_MAX_ROUNDS=5

# Optional WeChat subscription reminders (backend only).
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TEMPLATE_ID=
# Map the ACTUAL template keyword IDs to name/date/time/summary.
# Example only: {"thing1":"name","date2":"date","thing3":"summary"}
WECHAT_TEMPLATE_FIELDS={}
